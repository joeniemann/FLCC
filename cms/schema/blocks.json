{
  "_about": "Every block a page can hold, with each box exactly as a beginner sees it. The admin screens are generated from this file. kinds: text, headline (up to 2 lines), paragraph, richtext (bold, italic, link only), photo, link, list, choice, color, switch.",
  "blocks": {
    "pageHeader": {
      "name": "Page header",
      "help": "The big title area at the top of a page.",
      "fields": {
        "eyebrow": {
          "label": "Small line above the headline",
          "kind": "text",
          "max": 30
        },
        "headline": {
          "label": "Big headline",
          "kind": "headline",
          "lines": 2,
          "maxPerLine": 28
        },
        "intro": {
          "label": "Intro sentence",
          "kind": "paragraph",
          "max": 320
        },
        "facts": {
          "label": "Quick facts",
          "kind": "list",
          "min": 0,
          "max": 3,
          "item": {
            "big": {
              "label": "Big word or number",
              "kind": "text",
              "max": 12
            },
            "label": {
              "label": "Small label",
              "kind": "text",
              "max": 28
            }
          }
        },
        "factsAlign": {
          "label": "Line up the quick facts",
          "kind": "align",
          "optional": true,
          "options": [
            [
              "left",
              "Left"
            ],
            [
              "center",
              "Center"
            ],
            [
              "right",
              "Right"
            ]
          ]
        },
        "backdrop": {
          "label": "Background picture",
          "kind": "choice",
          "optional": true,
          "options": [
            [
              "",
              "None"
            ],
            [
              "sewing",
              "Sewing machine"
            ],
            [
              "welding",
              "Welding"
            ]
          ]
        },
        "look": {
          "label": "Light or dark",
          "kind": "choice",
          "optional": true,
          "options": [
            [
              "light",
              "Light"
            ],
            [
              "dark",
              "Dark"
            ]
          ],
          "note": "Leave empty to alternate automatically."
        },
        "factsFromHours": {
          "label": "Show the shop hours as the quick facts",
          "kind": "switch",
          "optional": true
        }
      }
    },
    "homeHero": {
      "name": "Home hero",
      "help": "The animated top of the home page. The logo, big headline and photos are locked.",
      "onlyOn": [
        "home"
      ],
      "fields": {
        "eyebrow": {
          "label": "Small line above the headline",
