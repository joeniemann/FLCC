        },
        "leadIn": {
          "label": "Bold lead-in",
          "kind": "text",
          "max": 50
        },
        "text": {
          "label": "Paragraph after it",
          "kind": "paragraph",
          "max": 220
        },
        "buttons": {
          "label": "Buttons",
          "kind": "list",
          "min": 1,
          "max": 2,
          "item": {
            "label": {
              "label": "Button words",
              "kind": "text",
              "max": 24
            },
            "link": {
              "label": "Button goes to",
              "kind": "link"
            },
            "style": {
              "label": "Look",
              "kind": "choice",
              "options": [
                [
                  "sewn",
                  "Orange"
                ],
                [
                  "heat",
                  "Glass"
                ],
                [
                  "line",
                  "Outline"
                ]
              ]
            }
          }
        }
      }
    },
